# ==============================================================================
# AlgoLab: Intelligent Algorithm Benchmark & Recommendation System
# Environment Configuration Template (.env.example)
# ==============================================================================

# Application Environment & Debug Mode
ENVIRONMENT=development
DEBUG=true

# Database Configuration
# Default SQLite: sqlite:///./algorithm_benchmark.db
# PostgreSQL (Production): postgresql://postgres:postgres@localhost:5432/algolab
DATABASE_URL=sqlite:///./algorithm_benchmark.db

# JWT & Authentication Security (Change in production!)
SECRET_KEY=dev-secret-key-change-in-production-daa-algorithm-benchmark-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Hardware-Isolated Microbenchmark Execution Guardrails
BENCHMARK_TIMEOUT_SECONDS=10.0
MAX_ARRAY_SIZE=1000000
MAX_GRAPH_VERTICES=5000
MAX_REPETITIONS=50
DEFAULT_WARMUP_RUNS=2

# CORS Whitelist (JSON array or comma-separated URLs)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173","*"]

# Frontend Vite Port & Proxy
VITE_API_BASE_URL=http://localhost:8000
PORT=8000
